# Build output: PyInstaller worker bundle (~170 MB, regenerated by build_desktop.ps1)
/worker/
/DBZ BT2 Guide.exe
/SHA256SUMS.txt

# Local runtime state (settings, logs, learned maps live in %LOCALAPPDATA%)
*.log
__pycache__/
*.pyc
.venv/

# Never commit game content
*.iso
*.chd
*.bin
!source/**/*.bin

# Game-derived reference material (extracted text, RAM dumps, research captures).
# Kept locally for development, never committed.
/reference/
*.afs
*.pak
