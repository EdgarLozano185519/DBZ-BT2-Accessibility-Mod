# Build output: PyInstaller worker bundle (~170 MB, regenerated by
# build_worker.ps1), plus any backup copies of a previously shipped one.
/worker/
/worker-*/
/DBZ BT2 Guide.exe
/SHA256SUMS.txt

# Build output: the standalone menu reader, regenerated by build_announcer.ps1
/dist/
/build/

# Local runtime state (settings, logs, learned maps live in %LOCALAPPDATA%)
*.log
__pycache__/
*.pyc
.venv/

# Never commit game content, or anything derived from it. No negation rules
# here: an exception like "!source/**/*.bin" silently re-admitted RAM dumps.
*.iso
*.chd
*.cso
*.afs
*.pak
*.bin

# Extracted text, RAM snapshots and screenshots of the running game.
# Deliberately not anchored, so it holds wherever a reference folder appears.
reference/
